prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: hft-sdk
Description: Low-latency LOB signal engine and market-data infrastructure
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lhft_sdk
