prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: hft-sdk
Description: Low-latency LOB signal engine and market-data infrastructure
Version: @PROJECT_VERSION@
Requires: @HFT_PC_REQUIRES@
Cflags: -I${includedir} -std=c++20 -pthread @HFT_PC_DEFINES@
Libs: @HFT_PC_LIBS@ -pthread

